{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pjanecze-xyz",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "pjanecze.xyz", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
